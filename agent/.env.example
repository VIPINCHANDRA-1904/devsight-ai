# ──────────────────────────────────────────────
# DEVSIGHTAI Monitoring Agent — Environment Variables
# ──────────────────────────────────────────────

# Backend API URL (where agent sends metrics)
DEVSIGHTAI_URL=http://localhost:8000

# Unique identifier for this server/machine
SERVER_ID=server-01

# Collection interval in seconds
COLLECTION_INTERVAL=10
